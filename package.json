{
  "name": "workflow-video",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "voice": "tsx scripts/generate-voice.ts",
    "voice:estimate": "tsx scripts/generate-voice.ts --estimate",
    "render": "remotion render src/index.ts workflow out/workflow.mp4",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.537",
    "@remotion/google-fonts": "4.0.537",
    "@remotion/transitions": "4.0.537",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "remotion": "4.0.537"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "tsx": "4.23.15",
    "typescript": "^5"
  }
}
